generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  summary  String
  sortOrder Int      @default(0)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  published   Boolean         @default(true)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
}

model Industry {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  summary   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Capability {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteRequest {
  id          String   @id @default(cuid())
  reference   String   @unique
  name        String
  company     String
  email       String
  phone       String
  country     String
  requirement String
  quantity    String?
  hasDrawing  Boolean  @default(false)
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
