# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unosujata?schema=public"

# ---- API ----
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 when none). Needed for correct rate limiting behind a proxy.
TRUST_PROXY=0

# ---- Uploads ----
# Private directory for drawings. Keep it outside any public web root.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Rate limits (requests per 15 minutes per IP) ----
RFQ_SUBMIT_LIMIT=10
RFQ_UPLOAD_LIMIT=60
RFQ_LOOKUP_LIMIT=60

# ---- Email ----
# "console" prints emails to the server log (development). "smtp" sends real mail.
EMAIL_PROVIDER=console
# Internal inbox for "New RFQ received" notifications.
RFQ_NOTIFY_EMAIL=sales@example.com
MAIL_FROM="UNO SUJATA <no-reply@example.com>"
# Only needed when EMAIL_PROVIDER=smtp. Store real values in your secret manager, never in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Staff administration ----
# Public product images, served read-only at /media (not the drawing store).
MEDIA_DIR=./public-media
# Send the session cookie only over HTTPS. Set true when running behind TLS in staging.
COOKIE_SECURE=false
# Requests per 15 minutes per IP for the admin API and sign-in.
ADMIN_LIMIT=600
ADMIN_LOGIN_LIMIT=10
# Contact form submissions per 15 minutes per IP.
CONTACT_LIMIT=10
# First administrator, created with: npm run admin:create (then clear these from your shell).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
